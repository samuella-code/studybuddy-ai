{
  "expo": {
    "name": "StudyBuddy",
    "slug": "studybuddy",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "studybuddy",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow StudyBuddy to use your microphone so you can talk to your AI tutor.",
          "speechRecognitionPermission": "Allow StudyBuddy to convert your speech into text."
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
